{
  "color-fg": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.1020, 0.0784, 0.0627],
      "hex": "#1a1410"
    },
    "$description": "Primary body text color. Near-black with a warm undertone."
  },
  "color-bg": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.9922, 0.9804, 0.9647],
      "hex": "#fdfaf6"
    },
    "$description": "Primary page background. Warm off-white, pairs with color-fg at >18:1 contrast."
  },
  "color-primary": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.8392, 0.1569, 0.1569],
      "hex": "#d62828"
    },
    "$description": "Bold tomato-red brand accent. Meets 4.5:1 with color-fg-inverse text."
  },
  "color-primary-hover": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.7216, 0.1216, 0.1216],
      "hex": "#b81f1f"
    },
    "$description": "Darkened hover/active state of color-primary."
  },
  "color-secondary": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.1765, 0.4157, 0.3098],
      "hex": "#2d6a4f"
    },
    "$description": "Basil-green secondary accent."
  },
  "color-border": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.8980, 0.8784, 0.8549],
      "hex": "#e5e0da"
    },
    "$description": "Default hairline border for cards, inputs, dividers."
  },
  "color-surface": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [1, 1, 1],
      "hex": "#ffffff"
    },
    "$description": "Raised surface background for cards and form controls."
  },
  "color-fg-inverse": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [1, 1, 1],
      "hex": "#ffffff"
    },
    "$description": "Text/icon color for use on color-primary or color-secondary backgrounds."
  },
  "color-fg-muted": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.4196, 0.3765, 0.3451],
      "hex": "#6b6058"
    },
    "$description": "Secondary/muted text color, e.g. captions and helper text."
  },
  "space-1": {
    "$type": "dimension",
    "$value": { "value": 4, "unit": "px" },
    "$description": "Smallest spacing increment."
  },
  "space-2": {
    "$type": "dimension",
    "$value": { "value": 8, "unit": "px" }
  },
  "space-3": {
    "$type": "dimension",
    "$value": { "value": 16, "unit": "px" }
  },
  "space-4": {
    "$type": "dimension",
    "$value": { "value": 24, "unit": "px" }
  },
  "radius-sm": {
    "$type": "dimension",
    "$value": { "value": 4, "unit": "px" }
  },
  "radius-md": {
    "$type": "dimension",
    "$value": { "value": 8, "unit": "px" }
  },
  "radius-lg": {
    "$type": "dimension",
    "$value": { "value": 16, "unit": "px" }
  },
  "font-size-sm": {
    "$type": "dimension",
    "$value": { "value": 14, "unit": "px" }
  },
  "font-size-md": {
    "$type": "dimension",
    "$value": { "value": 16, "unit": "px" }
  },
  "font-size-lg": {
    "$type": "dimension",
    "$value": { "value": 28, "unit": "px" }
  },
  "font-family-display": {
    "$type": "fontFamily",
    "$value": "Poppins, sans-serif",
    "$description": "Bold display/heading typeface."
  },
  "font-family-body": {
    "$type": "fontFamily",
    "$value": "Inter, sans-serif",
    "$description": "Body copy and UI typeface."
  },
  "font-weight-regular": {
    "$type": "fontWeight",
    "$value": 400
  },
  "font-weight-bold": {
    "$type": "fontWeight",
    "$value": 700
  },
  "font-weight-black": {
    "$type": "fontWeight",
    "$value": 900
  },
  "line-height-body": {
    "$type": "number",
    "$value": 1.5
  },
  "line-height-heading": {
    "$type": "number",
    "$value": 1.15
  },
  "border-width-default": {
    "$type": "dimension",
    "$value": { "value": 1, "unit": "px" }
  },
  "shadow-sm": {
    "$type": "shadow",
    "$value": {
      "color": {
        "colorSpace": "srgb",
        "components": [0.1020, 0.0784, 0.0627],
        "hex": "#1a1410",
        "alpha": 0.08
      },
      "offsetX": { "value": 0, "unit": "px" },
      "offsetY": { "value": 1, "unit": "px" },
      "blur": { "value": 2, "unit": "px" },
      "spread": { "value": 0, "unit": "px" }
    },
    "$description": "Subtle resting shadow for form controls and chips."
  },
  "shadow-md": {
    "$type": "shadow",
    "$value": {
      "color": {
        "colorSpace": "srgb",
        "components": [0.1020, 0.0784, 0.0627],
        "hex": "#1a1410",
        "alpha": 0.14
      },
      "offsetX": { "value": 0, "unit": "px" },
      "offsetY": { "value": 4, "unit": "px" },
      "blur": { "value": 12, "unit": "px" },
      "spread": { "value": 0, "unit": "px" }
    },
    "$description": "Elevated shadow for cards."
  },
  "border-default": {
    "$type": "border",
    "$value": {
      "color": "{color-border}",
      "width": "{border-width-default}",
      "style": "solid"
    },
    "$description": "Standard 1px hairline border used on cards and inputs."
  },
  "typography-heading": {
    "$type": "typography",
    "$value": {
      "fontFamily": "Poppins, sans-serif",
      "fontWeight": 900,
      "fontSize": { "value": 28, "unit": "px" },
      "lineHeight": 1.15,
      "letterSpacing": { "value": 0, "unit": "px" }
    },
    "$description": "Bold display heading style, e.g. page/section titles."
  },
  "typography-body": {
    "$type": "typography",
    "$value": {
      "fontFamily": "Inter, sans-serif",
      "fontWeight": 400,
      "fontSize": { "value": 16, "unit": "px" },
      "lineHeight": 1.5,
      "letterSpacing": { "value": 0, "unit": "px" }
    },
    "$description": "Default body copy style."
  },
  "button-primary-background": {
    "$type": "color",
    "$value": "{color-primary}"
  },
  "button-primary-background-hover": {
    "$type": "color",
    "$value": "{color-primary-hover}"
  },
  "button-primary-foreground": {
    "$type": "color",
    "$value": "{color-fg-inverse}"
  },
  "button-primary-border": {
    "$type": "color",
    "$value": "{color-primary}"
  },
  "button-primary-radius": {
    "$type": "dimension",
    "$value": "{radius-md}"
  },
  "button-secondary-background": {
    "$type": "color",
    "$value": "{color-surface}"
  },
  "button-secondary-foreground": {
    "$type": "color",
    "$value": "{color-primary}"
  },
  "button-secondary-border": {
    "$type": "color",
    "$value": "{color-primary}"
  },
  "button-secondary-radius": {
    "$type": "dimension",
    "$value": "{radius-md}"
  },
  "card-default-background": {
    "$type": "color",
    "$value": "{color-surface}"
  },
  "card-default-border": {
    "$type": "color",
    "$value": "{color-border}"
  },
  "card-default-radius": {
    "$type": "dimension",
    "$value": "{radius-lg}"
  },
  "chip-default-background": {
    "$type": "color",
    "$value": "{color-bg}"
  },
  "chip-default-foreground": {
    "$type": "color",
    "$value": "{color-fg}"
  },
  "chip-default-border": {
    "$type": "color",
    "$value": "{color-border}"
  },
  "chip-default-radius": {
    "$type": "dimension",
    "$value": "{radius-lg}"
  },
  "input-default-background": {
    "$type": "color",
    "$value": "{color-surface}"
  },
  "input-default-foreground": {
    "$type": "color",
    "$value": "{color-fg}"
  },
  "input-default-border": {
    "$type": "color",
    "$value": "{color-border}"
  },
  "input-default-radius": {
    "$type": "dimension",
    "$value": "{radius-sm}"
  }
}
